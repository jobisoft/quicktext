  "migration.pageTitle": {
    "message": "Quicktext v$VERSION$ Migration",
    "placeholders": { "version": { "content": "$1" } }
  },
  "migration.intro.p1": {
    "message": "This is the final step of a long update process to convert Quicktext into a modern WebExtension. Quicktext will soon no longer rely on legacy APIs and unrestricted access to your computer, but fully work within the modern WebExtension framework - no longer requiring an update for each new version of Thunderbird."
  },
  "migration.intro.quote": {
    "message": "Thank you to all my beta testers for your ongoing support and patience in making this transition possible. Your feedback has been invaluable!"
  },
  "migration.intro.quoteAttribution": {
    "message": "- John Bieling, Quicktext developer"
  },
  "migration.intro.p2": {
    "message": "Modern WebExtensions can no longer directly access your file system. As a result, your $ITEMTYPE$ definitions are now stored inside an internal Quicktext storage, and all attachments and images your templates reference need to be copied into that storage as well.",
    "placeholders": { "itemtype": { "content": "$1" } }
  },
  "migration.intro.itemType.template": {
    "message": "template"
  },
  "migration.intro.itemType.templateAndScript": {
    "message": "template and script"
  },
  "migration.intro.p3": {
    "message": "After migration, you may install additional $LINK$ and move your complete Quicktext configuration, for example to a WebDAV server.",
    "placeholders": { "link": { "content": "$1" } }
  },
  "migration.intro.p3.linkText": {
    "message": "storage backends"
  },
  "migration.section.autoMigration": {
    "message": "Automatic migration"
  },
  "migration.section.manualMigration": {
    "message": "Manual migration required"
  },
  "migration.section.droppedSources": {
    "message": "Removed configuration sources"
  },
  "migration.auto.intro": {
    "message": "The following templates can be migrated automatically. Local files will be copied into the internal Quicktext storage, and all tags in your templates referencing these files will be adjusted."
  },
  "migration.btn.startMigration": {
    "message": "Start template migration"
  },
  "migration.btn.startMigrationCount": {
    "message": "Start migration ($COUNT$ items)",
    "placeholders": { "count": { "content": "$1" } }
  },
  "migration.manual.intro": {
    "message": "The items listed below cannot be migrated automatically and require manual attention."
  },
  "migration.incompatible.title": {
    "message": "Incompatible scripts"
  },
  "migration.incompatible.description": {
    "message": "These scripts use deprecated Quicktext v5 APIs that are no longer available. They need to be rewritten using the $LINK$.",
    "placeholders": { "link": { "content": "$1" } }
  },
  "migration.incompatible.linkText": {
    "message": "modern script API"
  },
  "migration.filesystem.title": {
    "message": "Deprecated filesystem access"
  },
  "migration.filesystem.description": {
    "message": "These templates and scripts reference files on your local filesystem, which is no longer directly accessible to WebExtensions. The referenced files need to be copied into the Quicktext storage and the templates need to be adjusted accordingly. See the $LINK$ for details.",
    "placeholders": { "link": { "content": "$1" } }
  },
  "migration.filesystem.linkText": {
    "message": "storage locations guide"
  },
  "migration.dropped.intro": {
    "message": "The following configuration sources relied on direct filesystem access, which is no longer available in modern WebExtensions."
  },
  "migration.dropped.description": {
    "message": "If you previously used a local folder to store your templates or to share them across computers, you can install a $VFSLINK$ as a replacement - for example the $WEBDAVLINK$ to store templates on a WebDAV server (ownCloud, Nextcloud, etc.), or the $HOMEFOLDERLINK$ to continue using a folder on your computer.",
    "placeholders": {
      "vfslink": { "content": "$1" },
      "webdavlink": { "content": "$2" },
      "homefolderlink": { "content": "$3" }
    }
  },
  "migration.dropped.linkVfs": {
    "message": "VFS storage backend"
  },
  "migration.dropped.linkWebdav": {
    "message": "WebDAV provider"
  },
  "migration.dropped.linkHomefolder": {
    "message": "local home folder provider"
  },
  "migration.btn.dontShowAgain": {
    "message": "Don't show this report again"
  },
  "migration.reason.deprecatedFilesystem": {
    "message": "Deprecated direct filesystem access"
  },
  "migration.reason.deprecatedApi": {
    "message": "Incompatible Quicktext v5 API"
  },
  "migration.label.fileImport": {
    "message": "File-based import"
  },
  "migration.label.fileStorage": {
    "message": "File-based storage"
  },
  "migration.desc.fileImport": {
    "message": "This import read templates from a local file on every startup. WebExtensions can no longer directly access the local filesystem."
  },
  "migration.desc.fileStorage": {
    "message": "Templates and scripts were read from this local folder. WebExtensions can no longer directly access the local filesystem."
  },

{
  "quicktext.options.intro": {
    "message": "Okrem nižšie uvedeného nastavenia súkromia je možné všetky nastavenia Quicktextu ovládať a upravovať v Správcovi Quicktextu spolu s vašimi šablónami a skriptmi."
  },
  "quicktext.remoteRequests.legend": {
    "message": "Vzdialené požiadavky"
  },
  "quicktext.remoteRequests.label": {
    "message": "Povoliť šablónam kontaktovať vzdialené servery a odosielať im údaje (značka URL)"
  },
  "quicktext.remoteRequests.description": {
    "message": "Toto nastavenie je predvolene vypnuté. Kým je vypnuté, Quicktext blokuje každú požiadavku vytvorenú značkou URL a z vášho počítača neodchádzajú žiadne údaje. Keď ho zapnete, šablóna používajúca značku URL bude kontaktovať webovú adresu uvedenú v tejto šablóne a môže jej odoslať nasledujúce údaje, podľa toho, čo šablóna vyžaduje: príjemcov správy (Komu, Kópia, Skrytá kópia), vašu identitu odosielateľa, predmet, aktuálne vybraný text, aktuálny obsah schránky, názvy a veľkosti príloh a hlavičky a názvy príloh správy, na ktorú odpovedáte alebo ktorú preposielate. Webovú adresu určuje autor šablóny, nie Quicktext. Quicktextu ani jeho autorom sa neodosielajú žiadne údaje."
  },
  "quicktext.remoteBlocked.label": {
    "message": "Quicktext zablokoval požiadavku na adresu „$P1$“.\n\nTáto šablóna používa značku URL, ktorá môže odosielať údaje z vašej správy na vzdialený server. Ak to chcete povoliť, zapnite vzdialené požiadavky v nastaveniach Quicktextu (Doplnky a témy → Quicktext → Nastavenia), kde tiež uvidíte, čo sa odosiela.",
    "placeholders": {
      "P1": {
        "content": "$1"
      }
    }
  },

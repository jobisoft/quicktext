  "migration.intro.p1": {
    "message": "Toto je posledný krok dlhého procesu aktualizácií, ktorého cieľom je premeniť Quicktext na moderné rozšírenie WebExtension. Quicktext sa už čoskoro nebude spoliehať na staršie API a neobmedzený prístup k vášmu počítaču, ale bude plne fungovať v rámci moderného frameworku WebExtension – už nebude potrebná aktualizácia pri každej novej verzii Thunderbirdu."
  },
  "migration.intro.quote": {
    "message": "Ďakujem všetkým svojim beta testerom za ich neustálu podporu a trpezlivosť, vďaka ktorým bol tento prechod možný. Vaša spätná väzba bola neoceniteľná!"
  },
  "migration.intro.quoteAttribution": {
    "message": "- John Bieling, vývojár Quicktextu"
  },
  "migration.intro.p2": {
    "message": "Moderné WebExtensions už nemajú priamy prístup k vášmu súborovému systému. Preto sú vaše definície $ITEMTYPE$ teraz uložené vo vnútornom úložisku Quicktextu a všetky prílohy a obrázky, na ktoré sa vaše šablóny odvolávajú, je potrebné do tohto úložiska skopírovať.",
    "placeholders": {
      "itemtype": {
        "content": "$1"
      }
    }
  },
  "migration.intro.itemType.template": {
    "message": "šablón"
  },
  "migration.intro.itemType.templateAndScript": {
    "message": "šablón a skriptov"
  },
  "migration.intro.p3": {
    "message": "Po migrácii môžete nainštalovať ďalšie $LINK$ a presunúť celú svoju konfiguráciu Quicktextu, napríklad na server WebDAV.",
    "placeholders": {
      "link": {
        "content": "$1"
      }
    }
  },
  "migration.intro.p3.linkText": {
    "message": "úložné backendy"
  },
